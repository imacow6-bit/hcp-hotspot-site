        "columnHeaders": [
          {
            "fontColor": { "solid": { "color": "#FFFFFF" } },
            "backColor": { "solid": { "color": "#2E75B6" } },
            "bold": true,
            "fontSize": 10
          }
        ],
        "rowHeaders": [
          {
            "fontColor": { "solid": { "color": "#1C2D4A" } },
            "backColor": { "solid": { "color": "#F2F6FC" } },
            "bold": false,
            "fontSize": 10
          }
        ],
        "values": [
          {
            "fontColorPrimary": { "solid": { "color": "#1C2D4A" } },
            "backColorPrimary": { "solid": { "color": "#FFFFFF" } },
            "fontColorSecondary": { "solid": { "color": "#1C2D4A" } },
            "backColorSecondary": { "solid": { "color": "#F2F6FC" } },
            "fontSize": 10
          }
        ],
        "total": [
          {
            "fontColor": { "solid": { "color": "#2E75B6" } },
            "bold": true,
            "fontSize": 10
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#FFFFFF" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#D0DCF0" } },
            "radius": 6
          }
        ],
        "categoryAxis": [
          {
            "labelColor": { "solid": { "color": "#5A6A80" } },
            "fontSize": 9
          }
        ],
        "valueAxis": [
          {
            "labelColor": { "solid": { "color": "#5A6A80" } },
            "fontSize": 9,
            "gridlineColor": { "solid": { "color": "#E8EEF8" } }
          }
        ]
      }
