{
  "name": "MedscapeLIVE Pre-Sale Intelligence",
  "dataColors": [
    "#2E75B6",
    "#4472C4",
    "#5B9BD5",
    "#70AD47",
    "#ED7D31",
    "#FFC000",
    "#255E91",
    "#A5A5A5"
  ],
  "background": "#EAF0F8",
  "foreground": "#1C2D4A",
  "tableAccent": "#2E75B6",
  "textClasses": {
    "callout": {
      "fontSize": 36,
      "fontFace": "Segoe UI",
      "color": "#1C2D4A"
    },
    "title": {
      "fontSize": 12,
      "fontFace": "Segoe UI",
      "color": "#1C2D4A"
    },
    "header": {
      "fontSize": 11,
      "fontFace": "Segoe UI",
      "color": "#1C2D4A"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#5A6A80"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "fontFamily": [{ "value": "Segoe UI" }],
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#FFFFFF" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#D0DCF0" } },
            "radius": 6
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "color": { "solid": { "color": "#C0CEDF" } },
            "position": "outer",
            "preset": "topLeft"
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#1C2D4A" } },
            "background": { "solid": { "color": "#FFFFFF" } },
            "fontSize": 11,
            "fontFamily": "Segoe UI",
            "bold": true,
            "alignment": "left"
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#EAF0F8" } },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": { "solid": { "color": "#D6E4F0" } }
          }
        ]
      }
    },
    "card": {
      "*": {
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#FFFFFF" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#D0DCF0" } },
            "radius": 6
          }
