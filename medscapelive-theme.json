        ],
        "labels": [
          {
            "show": true,
            "color": { "solid": { "color": "#5A6A80" } },
            "fontSize": 10,
            "fontFamily": "Segoe UI"
          }
        ],
        "categoryLabels": [
          {
            "show": true,
            "color": { "solid": { "color": "#5A6A80" } },
            "fontSize": 10,
            "fontFamily": "Segoe UI"
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#FFFFFF" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#D0DCF0" } },
            "radius": 6
          }
        ],
        "header": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#1C2D4A" } },
            "background": { "solid": { "color": "#FFFFFF" } },
            "outline": "None",
            "textSize": 11,
            "fontFamily": "Segoe UI",
            "bold": true
          }
        ],
        "data": [
          {
            "fontColor": { "solid": { "color": "#1C2D4A" } },
            "textSize": 11,
            "fontFamily": "Segoe UI",
            "background": { "solid": { "color": "#FFFFFF" } }
          }
        ],
        "selection": [
          {
            "selectAllCheckboxEnabled": false,
            "singleSelect": true
          }
        ],
        "items": [
          {
            "fontColor": { "solid": { "color": "#1C2D4A" } },
            "background": { "solid": { "color": "#FFFFFF" } }
          }
        ]
