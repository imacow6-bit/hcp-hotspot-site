            "fontColorPrimary": { "solid": { "color": "#1C2D4A" } },
            "backColorPrimary": { "solid": { "color": "#FFFFFF" } },
            "fontColorSecondary": { "solid": { "color": "#1C2D4A" } },
            "backColorSecondary": { "solid": { "color": "#F2F6FC" } },
            "fontSize": 10,
            "fontFamily": "Segoe UI",
