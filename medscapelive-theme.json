        ]
      }
    },
    "columnChart": {
      "*": {
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#FFFFFF" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#D0DCF0" } },
            "radius": 6
          }
        ],
        "categoryAxis": [
          {
            "show": true,
            "labelColor": { "solid": { "color": "#5A6A80" } },
            "fontSize": 9,
            "fontFamily": "Segoe UI",
            "gridlineShow": false
          }
        ],
        "valueAxis": [
          {
            "show": true,
            "labelColor": { "solid": { "color": "#5A6A80" } },
            "fontSize": 9,
            "fontFamily": "Segoe UI",
            "gridlineShow": true,
            "gridlineColor": { "solid": { "color": "#E8EEF8" } }
          }
        ]
      }
    },
    "donutChart": {
      "*": {
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#FFFFFF" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#D0DCF0" } },
            "radius": 6
          }
        ],
        "legend": [
          {
            "show": true,
            "labelColor": { "solid": { "color": "#5A6A80" } },
            "fontSize": 9
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#FFFFFF" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#D0DCF0" } },
            "radius": 6
          }
        ],
        "grid": [
          {
            "gridVertical": false,
            "gridVerticalColor": { "solid": { "color": "#E8EEF8" } },
            "gridHorizontal": true,
            "gridHorizontalColor": { "solid": { "color": "#E8EEF8" } },
            "rowPadding": 4,
            "outlineColor": { "solid": { "color": "#D0DCF0" } },
